<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="gestionLeads_defs" targetNamespace="https://peluditos.cl/bpmn">
  <bpmn:message id="formularioLead" name="formularioLead" />
  <bpmn:process id="gestionLeads" name="Gestión de leads" isExecutable="true">
    <bpmn:documentation>El formulario inicia el proceso. Las tareas automáticas usan External Workers; la dueña resuelve la tarea humana en el panel. El correo del cupón se simula.</bpmn:documentation>
    <bpmn:startEvent id="start" name="Formulario recibido">
      <bpmn:outgoing>l3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="save" name="Registrar lead pendiente" flowable:type="external-worker" flowable:topic="guardarLead">
      <bpmn:incoming>l3</bpmn:incoming>
      <bpmn:outgoing>l4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="coupon" name="Generar y enviar cupón" flowable:type="external-worker" flowable:topic="enviarCupon">
      <bpmn:incoming>l4</bpmn:incoming>
      <bpmn:outgoing>l5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="follow" name="Conversar y registrar resultado" flowable:assignee="admin">
      <bpmn:incoming>l5</bpmn:incoming>
      <bpmn:outgoing>l6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="choice" name="¿Se concretó la compra?">
      <bpmn:incoming>l6</bpmn:incoming>
      <bpmn:outgoing>l7</bpmn:outgoing>
      <bpmn:outgoing>l9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="sale" name="Actualizar estado del lead a cliente" flowable:type="external-worker" flowable:topic="registrarCompra">
      <bpmn:incoming>l7</bpmn:incoming>
      <bpmn:outgoing>l8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endSale" name="Cliente registrado">
      <bpmn:incoming>l8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="lost" name="Actualizar estado del lead a no concretado" flowable:type="external-worker" flowable:topic="cerrarLead">
      <bpmn:incoming>l9</bpmn:incoming>
      <bpmn:outgoing>l10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endLost" name="Lead no concretado">
      <bpmn:incoming>l10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l3" sourceRef="start" targetRef="save" />
    <bpmn:sequenceFlow id="l4" sourceRef="save" targetRef="coupon" />
    <bpmn:sequenceFlow id="l5" sourceRef="coupon" targetRef="follow" />
    <bpmn:sequenceFlow id="l6" sourceRef="follow" targetRef="choice" />
    <bpmn:sequenceFlow id="l7" sourceRef="choice" targetRef="sale" name="Compra">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resultado == "COMPRA"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l8" sourceRef="sale" targetRef="endSale" />
    <bpmn:sequenceFlow id="l9" sourceRef="choice" targetRef="lost" name="Sin compra">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resultado == "NO_CONCRETADA"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l10" sourceRef="lost" targetRef="endLost" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="gestionLeads_diagram">
    <bpmndi:BPMNPlane id="gestionLeads_plane" bpmnElement="gestionLeads">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="40" y="180" width="56" height="56" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="10" y="246" width="116" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="save_di" bpmnElement="save">
        <dc:Bounds x="420" y="165" width="170" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="coupon_di" bpmnElement="coupon">
        <dc:Bounds x="630" y="165" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="follow_di" bpmnElement="follow">
        <dc:Bounds x="820" y="165" width="170" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="choice_di" bpmnElement="choice">
        <dc:Bounds x="1030" y="176" width="64" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sale_di" bpmnElement="sale">
        <dc:Bounds x="1190" y="65" width="170" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSale_di" bpmnElement="endSale">
        <dc:Bounds x="1400" y="80" width="56" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lost_di" bpmnElement="lost">
        <dc:Bounds x="1190" y="165" width="170" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endLost_di" bpmnElement="endLost">
        <dc:Bounds x="1400" y="180" width="56" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="l3_di" bpmnElement="l3">
        <di:waypoint x="96" y="208" /><di:waypoint x="420" y="208" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l4_di" bpmnElement="l4">
        <di:waypoint x="590" y="208" />
        <di:waypoint x="630" y="208" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l5_di" bpmnElement="l5">
        <di:waypoint x="780" y="208" />
        <di:waypoint x="820" y="208" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l6_di" bpmnElement="l6">
        <di:waypoint x="990" y="208" />
        <di:waypoint x="1030" y="208" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l7_di" bpmnElement="l7">
        <di:waypoint x="1062" y="176" />
        <di:waypoint x="1062" y="108" />
        <di:waypoint x="1190" y="108" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1100" y="78" width="65" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l8_di" bpmnElement="l8">
        <di:waypoint x="1360" y="108" />
        <di:waypoint x="1400" y="108" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l9_di" bpmnElement="l9">
        <di:waypoint x="1094" y="208" />
        <di:waypoint x="1190" y="208" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1100" y="179" width="85" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l10_di" bpmnElement="l10">
        <di:waypoint x="1360" y="208" />
        <di:waypoint x="1400" y="208" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>