<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="oportunidadesFechas_defs" targetNamespace="https://peluditos.cl/bpmn">
  <bpmn:message id="oportunidadDetectada" name="oportunidadDetectada" />
  <bpmn:process id="oportunidadesFechas" name="Cumpleaños de mascotas y eventos" isExecutable="true">
    <bpmn:documentation>Un planificador inicia una instancia 15 días antes y evita duplicados. El cliente no cambia de estado al abrir/cerrar una oportunidad. Los formularios y topics se implementan en el prototipo local; admin representa a la dueña.</bpmn:documentation>
    <bpmn:startEvent id="start" name="15 días antes del cumpleaños de mascota o evento">
      <bpmn:outgoing>p1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="oportunidadDetectada" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="suggest" name="Generar mensaje 15 días antes" flowable:type="external-worker" flowable:topic="generarSugerencia">
      <bpmn:incoming>p1</bpmn:incoming>
      <bpmn:outgoing>p2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="approve" name="Revisar y decidir envío" flowable:assignee="admin" flowable:formKey="aprobarMensaje">
      <bpmn:incoming>p2</bpmn:incoming>
      <bpmn:outgoing>p3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="sendChoice" name="¿Enviar correo?">
      <bpmn:incoming>p3</bpmn:incoming>
      <bpmn:outgoing>p4</bpmn:outgoing>
      <bpmn:outgoing>p5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="postpone" name="Envío pospuesto">
      <bpmn:incoming>p5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="email" name="Enviar correo" flowable:type="external-worker" flowable:topic="enviarCorreo">
      <bpmn:incoming>p4</bpmn:incoming>
      <bpmn:outgoing>p6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="follow" name="Conversar y registrar resultado" flowable:assignee="admin" flowable:formKey="resultadoOportunidad">
      <bpmn:incoming>p6</bpmn:incoming>
      <bpmn:outgoing>p7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="saleChoice" name="¿Se concretó la compra?">
      <bpmn:incoming>p7</bpmn:incoming>
      <bpmn:outgoing>p8</bpmn:outgoing>
      <bpmn:outgoing>p10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="sale" name="Venta concretada" flowable:type="external-worker" flowable:topic="registrarVenta">
      <bpmn:incoming>p8</bpmn:incoming>
      <bpmn:outgoing>p9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endSale" name="Venta concretada">
      <bpmn:incoming>p9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="lost" name="No concretada" flowable:type="external-worker" flowable:topic="cerrarOportunidad">
      <bpmn:incoming>p10</bpmn:incoming>
      <bpmn:outgoing>p11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endLost" name="Oportunidad no concretada">
      <bpmn:incoming>p11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="p1" sourceRef="start" targetRef="suggest" />
    <bpmn:sequenceFlow id="p2" sourceRef="suggest" targetRef="approve" />
    <bpmn:sequenceFlow id="p3" sourceRef="approve" targetRef="sendChoice" />
    <bpmn:sequenceFlow id="p4" sourceRef="sendChoice" targetRef="email" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${aprobado == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="p5" sourceRef="sendChoice" targetRef="postpone" name="Posponer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${aprobado == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="p6" sourceRef="email" targetRef="follow" />
    <bpmn:sequenceFlow id="p7" sourceRef="follow" targetRef="saleChoice" />
    <bpmn:sequenceFlow id="p8" sourceRef="saleChoice" targetRef="sale" name="Compra">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resultado == "COMPRA"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="p9" sourceRef="sale" targetRef="endSale" />
    <bpmn:sequenceFlow id="p10" sourceRef="saleChoice" targetRef="lost" name="Sin compra">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resultado == "NO_CONCRETADA"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="p11" sourceRef="lost" targetRef="endLost" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="oportunidadesFechas_diagram">
    <bpmndi:BPMNPlane id="oportunidadesFechas_plane" bpmnElement="oportunidadesFechas">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="40" y="180" width="56" height="56" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="10" y="246" width="116" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="suggest_di" bpmnElement="suggest">
        <dc:Bounds x="135" y="165" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approve_di" bpmnElement="approve">
        <dc:Bounds x="325" y="165" width="160" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sendChoice_di" bpmnElement="sendChoice">
        <dc:Bounds x="525" y="176" width="64" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="postpone_di" bpmnElement="postpone">
        <dc:Bounds x="529" y="335" width="56" height="56" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="499" y="396" width="116" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="email_di" bpmnElement="email">
        <dc:Bounds x="640" y="165" width="170" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="follow_di" bpmnElement="follow">
        <dc:Bounds x="850" y="165" width="170" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="saleChoice_di" bpmnElement="saleChoice">
        <dc:Bounds x="1060" y="176" width="64" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sale_di" bpmnElement="sale">
        <dc:Bounds x="1215" y="65" width="170" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSale_di" bpmnElement="endSale">
        <dc:Bounds x="1425" y="80" width="56" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lost_di" bpmnElement="lost">
        <dc:Bounds x="1215" y="165" width="170" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endLost_di" bpmnElement="endLost">
        <dc:Bounds x="1425" y="180" width="56" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="p1_di" bpmnElement="p1">
        <di:waypoint x="96" y="208" />
        <di:waypoint x="135" y="208" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p2_di" bpmnElement="p2">
        <di:waypoint x="285" y="208" />
        <di:waypoint x="325" y="208" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p3_di" bpmnElement="p3">
        <di:waypoint x="485" y="208" />
        <di:waypoint x="525" y="208" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p4_di" bpmnElement="p4">
        <di:waypoint x="589" y="208" />
        <di:waypoint x="640" y="208" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="598" y="177" width="32" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p5_di" bpmnElement="p5">
        <di:waypoint x="557" y="240" />
        <di:waypoint x="557" y="335" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="568" y="274" width="32" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p6_di" bpmnElement="p6">
        <di:waypoint x="810" y="208" />
        <di:waypoint x="850" y="208" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p7_di" bpmnElement="p7">
        <di:waypoint x="1020" y="208" />
        <di:waypoint x="1060" y="208" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p8_di" bpmnElement="p8">
        <di:waypoint x="1092" y="176" />
        <di:waypoint x="1092" y="108" />
        <di:waypoint x="1215" y="108" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1123" y="78" width="70" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p9_di" bpmnElement="p9">
        <di:waypoint x="1385" y="108" />
        <di:waypoint x="1425" y="108" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p10_di" bpmnElement="p10">
        <di:waypoint x="1124" y="208" />
        <di:waypoint x="1215" y="208" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1125" y="179" width="86" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p11_di" bpmnElement="p11">
        <di:waypoint x="1385" y="208" />
        <di:waypoint x="1425" y="208" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
